{
  "name": "macho-man",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "npm run dev:client",
    "dev:client": "vite",
    "dev:server": "wrangler dev",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "build:server": "wrangler deploy --dry-run --outdir server/dist",
    "lint": "oxlint",
    "preview": "vite preview",
    "deploy": "wrangler deploy --minify",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "wrangler": "^4.110.0"
  }
}
