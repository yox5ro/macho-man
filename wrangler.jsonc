{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "macho-man",
  "main": "server/src/index.ts",
  "compatibility_date": "2026-10-10",
  "d1_databases": [{ "binding": "DB", "database_name": "macho-man", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "server/migrations" }],
  "assets": { "directory": "./client/dist", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"] }
}
